{
  "dataset": {
    "image_transforms": {
      "enable": false
    },
    "use_imagenet_stats": false,
    "video_backend": "pyav",
    "streaming": false,
    "sources": [
      {
        "repo_id": "local/autodagger",
        "root": "/path/to/autodagger",
        "supervision": "autodagger"
      },
      {
        "repo_id": "local/demonstrations",
        "root": "/path/to/demonstrations",
        "supervision": "demonstration"
      }
    ]
  },
  "policy": {
    "type": "smolvla",
    "pretrained_path": "lerobot/smolvla_base",
    "device": "cuda",
    "push_to_hub": false,
    "chunk_size": 10,
    "n_action_steps": 10,
    "n_obs_steps": 1,
    "freeze_vision_encoder": true,
    "train_expert_only": true,
    "train_state_proj": true,
    "load_vlm_weights": false,
    "prefix_length": 0,
    "pad_language_to": "max_length",
    "num_expert_layers": 0,
    "optimizer_lr": 0.0001,
    "scheduler_warmup_steps": 1000,
    "scheduler_decay_steps": 30000
  },
  "distillation": {
    "teacher_url": "ws://127.0.0.1:8000",
    "teacher_id": "REPLACE_WITH_OPENPI_CHECKPOINT_AND_CONFIG_ID",
    "timeout_s": 60.0,
    "retries": 1,
    "kd_weight": 1.0,
    "bc_weight": 1.0
  },
  "output_dir": "outputs/train/smolvla_mixed_distill",
  "job_name": "smolvla_mixed_distill",
  "resume": false,
  "seed": 7,
  "num_workers": 4,
  "batch_size": 8,
  "steps": 30000,
  "eval_freq": 0,
  "log_freq": 10,
  "save_checkpoint": true,
  "save_freq": 5000,
  "use_policy_training_preset": true,
  "wandb": {
    "enable": false
  },
  "use_rabc": false
}
